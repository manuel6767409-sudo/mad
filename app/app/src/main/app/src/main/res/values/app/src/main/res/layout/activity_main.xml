<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:text="AR CHEAT LAUNCHER"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FF3333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:id="@+id/tvVersion"
            android:textSize="10sp"
            android:textColor="#444444"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>
        <EditText
            android:id="@+id/etServerIP"
            android:hint="Server IP"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="#1A1A1A"
            android:padding="14dp"
            android:inputType="text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"/>
        <EditText
            android:id="@+id/etServerPort"
            android:hint="Port (19133)"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="#1A1A1A"
            android:padding="14dp"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"/>
        <EditText
            android:id="@+id/etPlayerName"
            android:hint="Dein Name (optional)"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="#1A1A1A"
            android:padding="14dp"
            android:inputType="text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">
            <Button android:id="@+id/btnSave" android:text="SPEICHERN"
                android:textColor="#FFFFFF" android:background="#222222"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnTest" android:text="TESTEN"
                android:textColor="#FF3333" android:background="#1A0000"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView android:text="CHEATS" android:textSize="11sp"
            android:textColor="#FF3333" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#1A1A1A" android:padding="16dp" android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView android:text="Fliegen" android:textColor="#CCCCCC"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="15sp"/>
            <Switch android:id="@+id/swFly" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#1A1A1A" android:padding="16dp" android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView android:text="Speed x5" android:textColor="#CCCCCC"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="15sp"/>
            <Switch android:id="@+id/swSpeed" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#1A1A1A" android:padding="16dp" android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView android:text="KillAura (5m)" android:textColor="#CCCCCC"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="15sp"/>
            <Switch android:id="@+id/swKillAura" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#1A1A1A" android:padding="16dp" android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView android:text="ESP" android:textColor="#CCCCCC"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="15sp"/>
            <Switch android:id="@+id/swESP" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#1A1A1A" android:padding="16dp" android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView android:text="AntiKnockback" android:textColor="#CCCCCC"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="15sp"/>
            <Switch android:id="@+id/swAntiKB" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#1A1A1A" android:padding="16dp" android:layout_marginBottom="20dp"
            android:orientation="horizontal">
            <TextView android:text="Godmode" android:textColor="#CCCCCC"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="15sp"/>
            <Switch android:id="@+id/swGod" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:id="@+id/tvStatus" android:text="Bereit."
            android:textColor="#888888" android:textSize="12sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>
        <Button android:id="@+id/btnLaunch" android:text="MINECRAFT STARTEN"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp"
            android:background="#FF3333" android:padding="18dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
